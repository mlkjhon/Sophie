# Sophie - Variáveis de Ambiente para Vercel
# Copie para .env.local ou configure no painel da Vercel

# NVIDIA API (Nemotron 3 Ultra) - SUBSTITUA PELA SUA CHAVE
NVIDIA_API_KEY=sua_chave_nvidia_aqui

# Supabase PostgreSQL (com pgvector) - SUBSTITUA PELOS SEUS DADOS
POSTGRES_URL=postgresql://postgres:senha@host:5432/postgres

# URL da API (para o assistente de voz conectar) - SUBSTITUA PELA SUA URL VERCEL
SOPHIE_API_URL=https://seu-projeto.vercel.app/chat